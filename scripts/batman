#!/bin/sh

set -eu

script_path=$0
case $script_path in
    /*) ;;
    *) script_path="$PWD/$script_path" ;;
esac

while [ -L "$script_path" ]; do
    link_target=$(readlink "$script_path")
    case $link_target in
        /*) script_path=$link_target ;;
        *) script_path="$(dirname -- "$script_path")/$link_target" ;;
    esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
batman_config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/batman
default_profile_file="$batman_config_dir/default-profile"

# Handle help before loading installation state, validating sources, or prompting.
# shellcheck source=scripts/lib/batman-help.sh
. "$script_dir/lib/batman-help.sh"
help_command=${1:-}
help_action=${2:-}
usage() { command_help "$help_command" "$help_action"; }
if [ "$#" -eq 0 ]; then
    intro_help
    exit 0
fi
for help_argument in "$@"; do
    case $help_argument in
        -h|--help) usage; exit $? ;;
    esac
done

# shellcheck source=scripts/lib/batman-management.sh
. "$script_dir/lib/batman-management.sh"
management_work_dir=$(mktemp -d "${TMPDIR:-/tmp}/batman-command.XXXXXX")
trap 'rm -rf "$management_work_dir"' EXIT HUP INT TERM

parse_target() {
    if [ "${allow_groups:-0}" -eq 1 ]; then
        validate_skill_groups || return 2
    fi
    target=shared
    target_specified=0
    while [ "$#" -gt 0 ]; do
        case $1 in
            --group|--group=*)
                if [ "${allow_groups:-0}" -ne 1 ]; then
                    printf '%s\n' 'batman: --group is supported only by sync and status' >&2
                    return 2
                fi
                if [ "$1" = --group ]; then
                    if [ "$#" -lt 2 ]; then
                        printf '%s\n' 'batman: --group requires a value' >&2
                        return 2
                    fi
                    select_group "$2" || return 2
                    shift 2
                else
                    select_group "${1#--group=}" || return 2
                    shift
                fi
                ;;
            --target)
                if [ "$#" -lt 2 ]; then
                    printf '%s\n' 'batman: --target requires a value' >&2
                    return 2
                fi
                target=$2
                target_specified=1
                shift 2
                ;;
            --target=*)
                target=${1#--target=}
                target_specified=1
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                printf 'batman: unknown argument: %s\n' "$1" >&2
                return 2
                ;;
        esac
    done

    validate_target "$target" || return 2
    if [ "$target_specified" -eq 1 ]; then
        printf '%s\n' 'batman: --target is deprecated; using the shared skills folder.' >&2
    fi
    target=shared
}

run_status() {
    printf 'Skills directory: %s\n' "$shared_destination_dir"
    printf '%-18s %-12s %-12s %s\n' Skill Invocation 'Local state' Update
    status_target shared
}

run_invocation_change() {
    validate_skill "$2" || return 2
    set_skill_invocation "$2" "$1" shared
}

run_update() {
    validate_skill "$1" || return 2
    update_skill_on_target "$1" shared
}

case ${1:-} in
    scan)
        shift
        # shellcheck source=scripts/lib/batman-scan.sh
        . "$script_dir/lib/batman-scan.sh"
        run_scan "$@"
        ;;
    groups)
        shift
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 2
        fi
        list_skill_groups
        ;;
    config)
        shift
        case "$*" in
            'get default-profile')
                printf '%s\n' 'Shared installation is always used; default-profile is retired.'
                ;;
            'unset default-profile')
                if [ -f "$default_profile_file" ]; then
                    rm -f "$default_profile_file"
                fi
                printf '%s\n' 'Retired default profile cleared.'
                ;;
            *)
                printf '%s\n' 'batman: default-profile is retired; skills are shared in ~/.agents/skills.' >&2
                exit 2
                ;;
        esac
        ;;
    sync)
        shift
        allow_groups=1
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        set --
        for sync_group in $selected_groups; do
            set -- "$@" --group "$sync_group"
        done
        "$script_dir/sync-skills.sh" "$@"
        ;;
    status)
        shift
        allow_groups=1
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        run_status
        ;;
    enable|disable)
        command_name=$1
        shift
        if [ "$#" -lt 1 ]; then
            printf 'batman: %s requires a skill name\n' "$command_name" >&2
            usage >&2
            exit 2
        fi
        skill_name=$1
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        if [ "$command_name" = enable ]; then
            run_invocation_change automatic "$skill_name"
        else
            run_invocation_change manual "$skill_name"
        fi
        ;;
    update)
        shift
        if [ "$#" -lt 1 ]; then
            printf '%s\n' 'batman: update requires a skill name' >&2
            usage >&2
            exit 2
        fi
        skill_name=$1
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        run_update "$skill_name"
        ;;
    experimental)
        shift
        experimental_command=${1:-}
        case $experimental_command in
            list)
                shift
                parse_target "$@" || {
                    usage >&2
                    exit 2
                }
                list_experimental_skills "$target"
                ;;
            add|remove)
                shift
                if [ "$#" -lt 1 ]; then
                    printf 'batman: experimental %s requires a skill name\n' "$experimental_command" >&2
                    usage >&2
                    exit 2
                fi
                skill_name=$1
                shift
                parse_target "$@" || {
                    usage >&2
                    exit 2
                }
                if [ "$experimental_command" = add ]; then
                    "$script_dir/check-skills.sh" "$source_dir" >/dev/null
                fi
                validate_experimental_skill "$skill_name" || exit 2
                . "$script_dir/lib/batman-migration.sh"
                projection_work_dir=$management_work_dir
                migration_only_skill=$skill_name
                migration_failures=0
                migrate_shared_installation
                [ "$migration_failures" -eq 0 ] || exit 1
                if [ "$experimental_command" = add ]; then
                    add_experimental_skill "$skill_name" shared
                else
                    remove_experimental_skill "$skill_name" shared
                fi
                ;;
            *)
                printf 'batman: unknown experimental command: %s\n' "$experimental_command" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
