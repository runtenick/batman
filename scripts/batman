#!/bin/sh

set -eu

script_path=$0
case $script_path in
    /*) ;;
    *) script_path="$PWD/$script_path" ;;
esac

while [ -L "$script_path" ]; do
    link_target=$(readlink "$script_path")
    case $link_target in
        /*) script_path=$link_target ;;
        *) script_path="$(dirname -- "$script_path")/$link_target" ;;
    esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

# shellcheck source=scripts/lib/batman-management.sh
. "$script_dir/lib/batman-management.sh"
management_work_dir=$(mktemp -d "${TMPDIR:-/tmp}/batman-command.XXXXXX")
trap 'rm -rf "$management_work_dir"' EXIT HUP INT TERM

usage() {
    printf '%s\n' "Usage: $0 status [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 enable <skill> [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 disable <skill> [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 sync [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 update <skill> [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 experimental list [--target codex]"
    printf '%s\n' "       $0 experimental add <skill> [--target codex]"
    printf '%s\n' "       $0 experimental remove <skill> [--target codex]"
}

parse_target() {
    target=all
    while [ "$#" -gt 0 ]; do
        case $1 in
            --target)
                if [ "$#" -lt 2 ]; then
                    printf '%s\n' 'batman: --target requires a value' >&2
                    return 2
                fi
                target=$2
                shift 2
                ;;
            --target=*)
                target=${1#--target=}
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                printf 'batman: unknown argument: %s\n' "$1" >&2
                return 2
                ;;
        esac
    done

    validate_target "$target" || return 2
}

parse_experimental_target() {
    target=codex
    while [ "$#" -gt 0 ]; do
        case $1 in
            --target)
                if [ "$#" -lt 2 ]; then
                    printf '%s\n' 'batman: --target requires a value' >&2
                    return 2
                fi
                target=$2
                shift 2
                ;;
            --target=*)
                target=${1#--target=}
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                printf 'batman: unknown argument: %s\n' "$1" >&2
                return 2
                ;;
        esac
    done

    if [ "$target" != codex ]; then
        printf 'batman: experimental skills currently support only the codex target\n' >&2
        return 2
    fi
}

run_status() {
    target=$1
    printf '%-18s %-16s %-12s %-12s %s\n' Skill Target Invocation 'Local state' Update
    while IFS= read -r target_name; do
        status_target "$target_name"
    done <<EOF
$(target_list "$target")
EOF
}

run_invocation_change() {
    invocation=$1
    skill_name=$2
    target=$3
    validate_skill "$skill_name" || return 2

    failures=0
    while IFS= read -r target_name; do
        if ! set_skill_invocation "$skill_name" "$invocation" "$target_name"; then
            failures=$((failures + 1))
        fi
    done <<EOF
$(target_list "$target")
EOF

    [ "$failures" -eq 0 ]
}

run_update() {
    skill_name=$1
    target=$2
    validate_skill "$skill_name" || return 2

    failures=0
    for target_name in $(target_list "$target"); do
        if ! update_skill_on_target "$skill_name" "$target_name"; then
            failures=$((failures + 1))
        fi
    done

    [ "$failures" -eq 0 ]
}

case ${1:-} in
    sync)
        shift
        exec "$script_dir/install.sh" "$@"
        ;;
    status)
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        run_status "$target"
        ;;
    enable|disable)
        command_name=$1
        shift
        if [ "$#" -lt 1 ]; then
            printf 'batman: %s requires a skill name\n' "$command_name" >&2
            usage >&2
            exit 2
        fi
        skill_name=$1
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        if [ "$command_name" = enable ]; then
            run_invocation_change automatic "$skill_name" "$target"
        else
            run_invocation_change manual "$skill_name" "$target"
        fi
        ;;
    update)
        shift
        if [ "$#" -lt 1 ]; then
            printf '%s\n' 'batman: update requires a skill name' >&2
            usage >&2
            exit 2
        fi
        skill_name=$1
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        run_update "$skill_name" "$target"
        ;;
    experimental)
        shift
        experimental_command=${1:-}
        case $experimental_command in
            list)
                shift
                parse_experimental_target "$@" || {
                    usage >&2
                    exit 2
                }
                list_experimental_skills
                ;;
            add|remove)
                shift
                if [ "$#" -lt 1 ]; then
                    printf 'batman: experimental %s requires a skill name\n' "$experimental_command" >&2
                    usage >&2
                    exit 2
                fi
                skill_name=$1
                shift
                parse_experimental_target "$@" || {
                    usage >&2
                    exit 2
                }
                if [ "$experimental_command" = add ]; then
                    "$script_dir/check-skills.sh" "$source_dir" >/dev/null
                    add_experimental_skill "$skill_name"
                else
                    remove_experimental_skill "$skill_name"
                fi
                ;;
            *)
                printf 'batman: unknown experimental command: %s\n' "$experimental_command" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
