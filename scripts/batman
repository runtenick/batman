#!/bin/sh

set -eu

script_path=$0
case $script_path in
    /*) ;;
    *) script_path="$PWD/$script_path" ;;
esac

while [ -L "$script_path" ]; do
    link_target=$(readlink "$script_path")
    case $link_target in
        /*) script_path=$link_target ;;
        *) script_path="$(dirname -- "$script_path")/$link_target" ;;
    esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
batman_config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/batman
default_profile_file="$batman_config_dir/default-profile"

# shellcheck source=scripts/lib/batman-management.sh
. "$script_dir/lib/batman-management.sh"
management_work_dir=$(mktemp -d "${TMPDIR:-/tmp}/batman-command.XXXXXX")
trap 'rm -rf "$management_work_dir"' EXIT HUP INT TERM

usage() {
    printf '%s\n' "Usage: $0 status [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 enable <skill> [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 disable <skill> [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 sync [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 update <skill> [--target codex|copilot|portable|all]"
    printf '%s\n' "       $0 experimental list [--target codex|copilot|all]"
    printf '%s\n' "       $0 experimental add <skill> [--target codex|copilot|all]"
    printf '%s\n' "       $0 experimental remove <skill> [--target codex|copilot|all]"
    printf '%s\n' "       $0 config get default-profile"
    printf '%s\n' "       $0 config set default-profile <codex|copilot>"
    printf '%s\n' "       $0 config unset default-profile"
}

get_default_profile() {
    [ -f "$default_profile_file" ] || return 1

    configured_profile=$(sed -n '1p' "$default_profile_file")
    case $configured_profile in
        codex|copilot)
            printf '%s\n' "$configured_profile"
            ;;
        *)
            printf 'batman: invalid default profile in %s; expected codex or copilot\n' "$default_profile_file" >&2
            return 2
            ;;
    esac
}

set_default_profile() {
    new_default_profile=$1
    case $new_default_profile in
        codex|copilot) ;;
        *)
            printf '%s\n' 'batman: default profile must be codex or copilot' >&2
            return 2
            ;;
    esac

    mkdir -p "$batman_config_dir"
    config_tmp=$(mktemp "$batman_config_dir/default-profile.XXXXXX") || return 1
    if ! (umask 077; printf '%s\n' "$new_default_profile" > "$config_tmp"); then
        rm -f "$config_tmp"
        return 1
    fi
    if ! mv -f "$config_tmp" "$default_profile_file"; then
        rm -f "$config_tmp"
        return 1
    fi

    printf 'Default profile set to %s.\n' "$new_default_profile"
}

unset_default_profile() {
    if [ -f "$default_profile_file" ]; then
        rm -f "$default_profile_file"
        printf '%s\n' 'Default profile cleared.'
    else
        printf '%s\n' 'No default profile is set.'
    fi
}

agent_target_available() {
    agent_name=$1
    case $agent_name in
        codex)
            cli_name=codex
            agent_destination_dir=$codex_destination_dir
            ;;
        copilot)
            cli_name=copilot
            agent_destination_dir=$copilot_destination_dir
            ;;
        *)
            return 1
            ;;
    esac

    if command -v "$cli_name" >/dev/null 2>&1 || [ -f "$agent_destination_dir/.batman/state.tsv" ]; then
        return 0
    fi

    for source_skill in "$source_dir"/* "$experimental_source_dir"/*; do
        [ -d "$source_skill" ] || continue
        [ -f "$source_skill/SKILL.md" ] || continue
        installed_skill="$agent_destination_dir/${source_skill##*/}"

        if [ -f "$installed_skill/.batman-source" ] && [ "$(sed -n '1p' "$installed_skill/.batman-source")" = "$source_skill" ]; then
            return 0
        fi
        if [ -L "$installed_skill" ] && [ "$(readlink "$installed_skill")" = "$source_skill" ]; then
            return 0
        fi
    done

    return 1
}

resolve_implicit_target() {
    default_target=$1

    if configured_profile=$(get_default_profile); then
        target=$configured_profile
        return 0
    else
        profile_status=$?
        [ "$profile_status" -eq 1 ] || return "$profile_status"
    fi

    available_count=0
    first_available=
    second_available=

    for agent_name in codex copilot; do
        if agent_target_available "$agent_name"; then
            available_count=$((available_count + 1))
            if [ "$available_count" -eq 1 ]; then
                first_available=$agent_name
            else
                second_available=$agent_name
            fi
        fi
    done

    case $available_count in
        0)
            target=$default_target
            ;;
        1)
            target=$first_available
            ;;
        *)
            if [ ! -t 0 ] || [ ! -r /dev/tty ]; then
                printf '%s\n' 'batman: multiple agents are available; specify --target codex, --target copilot, or --target all' >&2
                return 2
            fi

            printf '%s\n' 'Multiple agents are available. Select one for this command:' >/dev/tty
            printf '  1) %s\n  2) %s\n' "$first_available" "$second_available" >/dev/tty
            while :; do
                printf 'Select [1-2]: ' >/dev/tty
                if ! IFS= read -r selection </dev/tty; then
                    printf '\n' >/dev/tty
                    return 2
                fi
                case $selection in
                    1)
                        target=$first_available
                        return 0
                        ;;
                    2)
                        target=$second_available
                        return 0
                        ;;
                    *)
                        printf '%s\n' 'Enter 1 or 2.' >/dev/tty
                        ;;
                esac
            done
            ;;
    esac
}

parse_target() {
    target=all
    target_specified=0
    while [ "$#" -gt 0 ]; do
        case $1 in
            --target)
                if [ "$#" -lt 2 ]; then
                    printf '%s\n' 'batman: --target requires a value' >&2
                    return 2
                fi
                target=$2
                target_specified=1
                shift 2
                ;;
            --target=*)
                target=${1#--target=}
                target_specified=1
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                printf 'batman: unknown argument: %s\n' "$1" >&2
                return 2
                ;;
        esac
    done

    if [ "$target_specified" -eq 0 ]; then
        resolve_implicit_target all || return 2
    fi

    validate_target "$target" || return 2
}

parse_experimental_target() {
    target=codex
    target_specified=0
    while [ "$#" -gt 0 ]; do
        case $1 in
            --target)
                if [ "$#" -lt 2 ]; then
                    printf '%s\n' 'batman: --target requires a value' >&2
                    return 2
                fi
                target=$2
                target_specified=1
                shift 2
                ;;
            --target=*)
                target=${1#--target=}
                target_specified=1
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                printf 'batman: unknown argument: %s\n' "$1" >&2
                return 2
                ;;
        esac
    done

    if [ "$target_specified" -eq 0 ]; then
        resolve_implicit_target codex || return 2
    fi

    case $target in
        codex|copilot|all) ;;
        *)
            printf 'batman: experimental skills support codex, copilot, or all\n' >&2
            return 2
            ;;
    esac
}

run_experimental_change() {
    action=$1
    skill_name=$2
    requested_target=$3
    failures=0

    for target_name in $(target_list "$requested_target"); do
        if [ "$action" = add ]; then
            if ! add_experimental_skill "$skill_name" "$target_name"; then
                failures=$((failures + 1))
            fi
        elif ! remove_experimental_skill "$skill_name" "$target_name"; then
            failures=$((failures + 1))
        fi
    done

    [ "$failures" -eq 0 ]
}

run_status() {
    target=$1
    printf '%-18s %-16s %-12s %-12s %s\n' Skill Target Invocation 'Local state' Update
    while IFS= read -r target_name; do
        status_target "$target_name"
    done <<EOF
$(target_list "$target")
EOF
}

run_invocation_change() {
    invocation=$1
    skill_name=$2
    target=$3
    validate_skill "$skill_name" || return 2

    failures=0
    while IFS= read -r target_name; do
        if ! set_skill_invocation "$skill_name" "$invocation" "$target_name"; then
            failures=$((failures + 1))
        fi
    done <<EOF
$(target_list "$target")
EOF

    [ "$failures" -eq 0 ]
}

run_update() {
    skill_name=$1
    target=$2
    validate_skill "$skill_name" || return 2

    failures=0
    for target_name in $(target_list "$target"); do
        if ! update_skill_on_target "$skill_name" "$target_name"; then
            failures=$((failures + 1))
        fi
    done

    [ "$failures" -eq 0 ]
}

case ${1:-} in
    config)
        shift
        config_action=${1:-}
        case $config_action in
            get)
                shift
                if [ "${1:-}" != default-profile ] || [ "$#" -ne 1 ]; then
                    printf '%s\n' 'batman: expected config get default-profile' >&2
                    usage >&2
                    exit 2
                fi
                if configured_profile=$(get_default_profile); then
                    printf '%s\n' "$configured_profile"
                else
                    profile_status=$?
                    if [ "$profile_status" -eq 1 ]; then
                        printf '%s\n' 'No default profile is set.'
                    else
                        exit "$profile_status"
                    fi
                fi
                ;;
            set)
                shift
                if [ "${1:-}" != default-profile ] || [ "$#" -ne 2 ]; then
                    printf '%s\n' 'batman: expected config set default-profile <codex|copilot>' >&2
                    usage >&2
                    exit 2
                fi
                set_default_profile "$2"
                ;;
            unset)
                shift
                if [ "${1:-}" != default-profile ] || [ "$#" -ne 1 ]; then
                    printf '%s\n' 'batman: expected config unset default-profile' >&2
                    usage >&2
                    exit 2
                fi
                unset_default_profile
                ;;
            *)
                printf 'batman: unknown config command: %s\n' "$config_action" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    sync)
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        exec "$script_dir/install.sh" --target "$target"
        ;;
    status)
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        run_status "$target"
        ;;
    enable|disable)
        command_name=$1
        shift
        if [ "$#" -lt 1 ]; then
            printf 'batman: %s requires a skill name\n' "$command_name" >&2
            usage >&2
            exit 2
        fi
        skill_name=$1
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        if [ "$command_name" = enable ]; then
            run_invocation_change automatic "$skill_name" "$target"
        else
            run_invocation_change manual "$skill_name" "$target"
        fi
        ;;
    update)
        shift
        if [ "$#" -lt 1 ]; then
            printf '%s\n' 'batman: update requires a skill name' >&2
            usage >&2
            exit 2
        fi
        skill_name=$1
        shift
        parse_target "$@" || {
            usage >&2
            exit 2
        }
        run_update "$skill_name" "$target"
        ;;
    experimental)
        shift
        experimental_command=${1:-}
        case $experimental_command in
            list)
                shift
                parse_experimental_target "$@" || {
                    usage >&2
                    exit 2
                }
                list_experimental_skills "$target"
                ;;
            add|remove)
                shift
                if [ "$#" -lt 1 ]; then
                    printf 'batman: experimental %s requires a skill name\n' "$experimental_command" >&2
                    usage >&2
                    exit 2
                fi
                skill_name=$1
                shift
                parse_experimental_target "$@" || {
                    usage >&2
                    exit 2
                }
                if [ "$experimental_command" = add ]; then
                    "$script_dir/check-skills.sh" "$source_dir" >/dev/null
                fi
                run_experimental_change "$experimental_command" "$skill_name" "$target"
                ;;
            *)
                printf 'batman: unknown experimental command: %s\n' "$experimental_command" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
